        function getWords(text) {
            return text.trim().split(/\s+/).filter(w => w.length > 0);
        }

        function updateWordCount() {
            const text = document.getElementById('emailInput').value;
            const count = getWords(text).length;

            const badge = document.getElementById('wordCountBadge');
            badge.innerText = `${count} / 30-50 words`;

            const percentage = Math.min(100, Math.round((count / 50) * 100));
            const progressBar = document.getElementById('expProgressBar');
            progressBar.style.width = `${percentage}%`;

            if (count >= 30 && count <= 50) {
                progressBar.className = "bg-kawaii-green h-full rounded-full transition-all duration-300";
            } else if (count > 50) {
                progressBar.className = "bg-rose-500 h-full rounded-full transition-all duration-300";
            } else {
                progressBar.className = "bg-kawaii-pink h-full rounded-full transition-all duration-300";
            }
        }

        function checkEmailStructure(text) {
            const trimmed = text.trim();
            const lines = trimmed.split('\n').map(l => l.trim()).filter(l => l.length > 0);
            
            // Check Greeting/Salutation at the beginning
            const hasGreeting = /^(hi|hello|dear)\b/i.test(trimmed) || 
                                (lines.length > 0 && /^(hi|hello|dear)\b/i.test(lines[0]));

            // Check Closing / Sender name at the end
            let hasSenderName = false;
            if (lines.length >= 2) {
                const lastLine = lines[lines.length - 1];
                const lastLineWords = lastLine.split(/\s+/).length;
                // Last line should be a short sign-off line (1 to 4 words, e.g. "From, Amir" or "Amir")
                if (lastLineWords <= 5) {
                    hasSenderName = true;
                }
            }

            return {
                hasGreeting,
                hasSenderName,
                isValid: hasGreeting && hasSenderName
            };
        }

        function analyzeEmail() {
            const text = document.getElementById('emailInput').value.trim();
            const errorBox = document.getElementById('validationErrorBox');
            const errorList = document.getElementById('validationErrorList');

            if (!text) {
                errorBox.classList.remove('hidden');
                errorList.innerHTML = `<li>Please write your email before checking!</li>`;
                return;
            }

            // Perform mandatory structure validation (Greeting & Sender Name)
            const structCheck = checkEmailStructure(text);
            if (!structCheck.isValid) {
                errorBox.classList.remove('hidden');
                errorList.innerHTML = '';

                if (!structCheck.hasGreeting) {
                    errorList.innerHTML += `
                        <li><strong>Missing Greeting:</strong> You MUST start your email with a greeting like <code>Hi Kevin,</code>, <code>Hello Kevin,</code>, or <code>Dear Kevin,</code>.</li>
                    `;
                }

                if (!structCheck.hasSenderName) {
                    errorList.innerHTML += `
                        <li><strong>Missing Sender Name:</strong> You MUST write your name or sign-off at the end of the email (e.g., <code>From, ${studentData.name || 'Amir'}</code> or <code>Your friend, ${studentData.name || 'Amir'}</code>).</li>
                    `;
                }

                document.getElementById('feedbackSection').classList.add('hidden');
                errorBox.scrollIntoView({ behavior: 'smooth' });
                return;
            }

            // Hide validation error box if structure is valid
            errorBox.classList.add('hidden');

            studentData.emailText = text;
            const wordCount = getWords(text).length;

            document.getElementById('feedbackSection').classList.remove('hidden');

            const textLower = text.toLowerCase();

            // Requirement 1: Invite
            const hasInvite = (textLower.includes('invite') || textLower.includes('join') || textLower.includes('come') || textLower.includes('go with me'));
            updateReqStatus('reqInvite', 'reqInviteIcon', hasInvite);

            // Requirement 2: Day & Time
            const hasDayTime = dayKeywords.some(d => textLower.includes(d)) || timeKeywords.some(t => textLower.includes(t));
            updateReqStatus('reqDateTime', 'reqDateTimeIcon', hasDayTime);

            // Requirement 3: Food
            const hasFood = foodKeywords.some(f => textLower.includes(f));
            updateReqStatus('reqFood', 'reqFoodIcon', hasFood);

            // Word Count Feedback Banner with BM support in Review Section
            const banner = document.getElementById('wordCountBanner');
            if (wordCount >= 30 && wordCount <= 50) {
                banner.className = "p-3.5 rounded-2xl text-xs font-semibold flex items-center justify-between border-2 bg-emerald-50 text-emerald-900 border-emerald-300";
                banner.innerHTML = `<span>🎉 <strong>Perfect Word Count!</strong> (${wordCount} Words) <span class="text-emerald-700 italic">(Panjang perkataan sempurna!)</span></span>`;
            } else if (wordCount < 30) {
                banner.className = "p-3.5 rounded-2xl text-xs font-semibold flex items-center justify-between border-2 bg-amber-50 text-amber-900 border-amber-300";
                banner.innerHTML = `<span>⚠️ <strong>Too Short:</strong> (${wordCount} / Min 30 words). Please add a bit more detail. <span class="text-amber-800 italic">(Kurang perkataan, sila tambah sedikit lagi.)</span></span>`;
            } else {
                banner.className = "p-3.5 rounded-2xl text-xs font-semibold flex items-center justify-between border-2 bg-rose-50 text-rose-900 border-rose-300";
                banner.innerHTML = `<span>❌ <strong>Too Long:</strong> (${wordCount} / Max 50 words). Please shorten your response. <span class="text-rose-800 italic">(Terlalu panjang, sila ringkaskan.)</span></span>`;
            }

            // Detect Errors
            let detected = [];

            // 1. Dynamic Dictionary Spell Check
            const rawWords = text.split(/\s+/);
            const checkedWords = new Set();

            rawWords.forEach(rawWord => {
                const cleaned = rawWord.replace(/^[^\w']+|[^\w']+$|\.$/g, '');
                const cleanLower = cleaned.toLowerCase();

                if (!cleaned || /^\d+$/.test(cleaned) || cleanLower === studentData.name.toLowerCase()) return;

                if (!VALID_DICTIONARY.has(cleanLower) && !checkedWords.has(cleanLower)) {
                    checkedWords.add(cleanLower);
                    
                    const suggestion = findBestCorrection(cleaned);
                    
                    if (!detected.some(d => d.original.toLowerCase() === cleaned.toLowerCase())) {
                        detected.push({
                            original: cleaned,
                            suggestion: suggestion || `[Check spelling of "${cleaned}"]`,
                            message: suggestion 
                                ? `Spelling Error: Did you mean "${suggestion}"? (Ejaan salah: Adakah anda bermaksud "${suggestion}"?)`
                                : `Spelling Error: Word "${cleaned}" not recognized in dictionary. (Ejaan salah: Perkataan "${cleaned}" tidak dijumpai.)`,
                            type: 'Spelling',
                            badgeColor: 'bg-rose-500'
                        });
                    }
                }
            });

            // 2. Pattern Rules
            grammarRules.forEach(rule => {
                const matches = text.match(rule.pattern);
                if (matches) {
                    matches.forEach(m => {
                        let sug = typeof rule.replacement === 'function' ? rule.replacement(m) : rule.replacement;
                        if (!detected.some(d => d.original === m)) {
                            detected.push({ original: m, suggestion: sug, message: rule.message, type: rule.type, badgeColor: rule.badgeColor });
                        }
                    });
                }
            });

            // 3. Comma Check after Salutation
            if (/^(hi|dear|hello)\s+kevin\b(?!,)/i.test(text)) {
                const match = text.match(/^(hi|dear|hello)\s+kevin\b/i)[0];
                if (!detected.some(d => d.original === match)) {
                    detected.push({
                        original: match,
                        suggestion: match + ",",
                        message: "Punctuation: Add a comma \",\" after greeting Kevin (e.g. Hi Kevin,). (Tambahkan tanda koma \",\" selepas Hi Kevin,)",
                        type: "Punctuation",
                        badgeColor: "bg-amber-500"
                    });
                }
            }

            // 4. Lowercase after period check
            const periodLowercaseMatches = text.match(/\.\s+[a-z]/g);
            if (periodLowercaseMatches) {
                periodLowercaseMatches.forEach(m => {
                    const originalStr = m.trim();
                    const sugStr = originalStr.charAt(0) + " " + originalStr.charAt(2).toUpperCase();
                    if (!detected.some(d => d.original === originalStr)) {
                        detected.push({
                            original: originalStr,
                            suggestion: sugStr,
                            message: "Capitalization: Start new sentences with a capital letter. (Permulaan ayat baharu mesti bermula huruf besar.)",
                            type: "Capitalization",
                            badgeColor: "bg-blue-500"
                        });
                    }
                });
            }

            // 5. Missing period at end
            if (!/[.!?]$/.test(text.trim())) {
                const words = getWords(text);
                const lastWord = words[words.length - 1];
                if (lastWord && !detected.some(d => d.original === lastWord)) {
                    detected.push({
                        original: lastWord,
                        suggestion: lastWord + ".",
                        message: "Punctuation: Add a closing period \".\" at the end of your sentence. (Tambahkan tanda noktah \".\" di hujung ayat.)",
                        type: "Punctuation",
                        badgeColor: "bg-amber-500"
                    });
                }
            }

            renderGrammarOutput(text, detected);
            document.getElementById('feedbackSection').scrollIntoView({ behavior: 'smooth' });
        }

        function updateReqStatus(elemId, iconId, isOk) {
            const el = document.getElementById(elemId);
            const ic = document.getElementById(iconId);
            if (isOk) {
                el.className = "p-3.5 rounded-2xl border-2 border-slate-800 bg-emerald-100 text-slate-900 flex items-start space-x-3";
                ic.innerHTML = `<i class="fa-solid fa-circle-check text-emerald-600 text-lg"></i>`;
            } else {
                el.className = "p-3.5 rounded-2xl border-2 border-slate-800 bg-rose-100 text-slate-900 flex items-start space-x-3";
                ic.innerHTML = `<i class="fa-solid fa-circle-xmark text-rose-600 text-lg"></i>`;
            }
        }

        function renderGrammarOutput(originalText, issues) {
            const outputDiv = document.getElementById('highlightedOutput');
            const container = document.getElementById('suggestionsContainer');
            const badge = document.getElementById('scoreBadge');

            let temp = originalText;
            issues.forEach(iss => {
                const reg = new RegExp(`\\b${escapeRegExp(iss.original)}\\b`, 'g');
                temp = temp.replace(reg, `<span class="highlight-error">${iss.original}</span>`);
            });
            outputDiv.innerHTML = temp;

            container.innerHTML = '';

            if (issues.length === 0) {
                container.innerHTML = `
                    <div class="p-4 bg-emerald-100 border-2 border-slate-800 rounded-2xl flex items-center gap-3 text-slate-900 font-bold text-xs">
                        <span class="text-2xl">🌟</span>
                        <div>
                            <p class="text-sm font-heading">PERFECT SPELLING, PUNCTUATION & GRAMMAR!</p>
                            <p class="text-slate-600 font-medium">No mistakes found in your text. Outstanding work! <span class="italic">(Tiada sebarang kesalahan ditemui. Tahniah!)</span></p>
                        </div>
                    </div>
                `;
                badge.innerText = "GRADE: S (EXCELLENT ⭐⭐⭐)";
                if (typeof confetti === 'function') confetti({ particleCount: 80, spread: 70 });
            } else {
                badge.innerText = `GRADE: ${issues.length <= 2 ? 'A (GOOD ⭐⭐)' : 'B (NEEDS FIX ⭐)'}`;
                issues.forEach((iss, i) => {
                    const card = document.createElement('div');
                    card.className = "p-3.5 bg-pink-50 border-2 border-slate-800 rounded-2xl space-y-1 text-xs font-semibold text-slate-800";
                    card.innerHTML = `
                        <div class="flex items-center justify-between text-[10px] font-heading">
                            <span class="${iss.badgeColor || 'bg-rose-500'} text-white px-2 py-0.5 rounded-md font-bold">${iss.type}</span>
                            <span class="text-slate-500">TIP #${i + 1}</span>
                        </div>
                        <div class="flex items-center gap-2 pt-1 text-sm font-bold">
                            <span class="line-through text-rose-600">${escapeHtml(iss.original)}</span>
                            <span>➔</span>
                            <span class="text-emerald-700 bg-white px-2 py-0.5 rounded border border-emerald-400 font-bold">${escapeHtml(iss.suggestion)}</span>
                        </div>
                        <p class="text-slate-600 font-medium pt-0.5">💡 ${iss.message}</p>
                    `;
                    container.appendChild(card);
                });
            }
        }

        function goToStep3() {
            document.getElementById('certName').innerText = studentData.name;
            document.getElementById('certClass').innerText = studentData.studentClass;
            document.getElementById('certWordCount').innerText = `${getWords(studentData.emailText).length} Words`;
            document.getElementById('certEmailText').innerText = studentData.emailText;

            const now = new Date();
            document.getElementById('finalDate').innerText = `Date: ${now.toLocaleDateString('en-MY')}`;

            const passed = document.querySelectorAll('#feedbackSection .bg-emerald-100').length;
            document.getElementById('certScore').innerText = `${passed} / 3 Goals Cleared`;

            document.getElementById('step2Card').classList.add('hidden');
            document.getElementById('step3Card').classList.remove('hidden');

            document.getElementById('levelText').innerText = 'LEVEL 3: QUEST COMPLETED!';
            window.scrollTo({ top: 0, behavior: 'smooth' });

            if (typeof confetti === 'function') confetti({ particleCount: 120, spread: 80 });
        }

        function backToEdit() {
            document.getElementById('step3Card').classList.add('hidden');
            document.getElementById('step2Card').classList.remove('hidden');
            document.getElementById('levelText').innerText = 'LEVEL 2: QUEST WORKSPACE';
        }

        function escapeRegExp(s) { return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }
        function escapeHtml(s) { return s ? s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;") : ''; }
    </script>
</body>
</html>
