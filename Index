        function levenshteinDistance(a, b) {
            const matrix = [];
            for (let i = 0; i <= b.length; i++) matrix[i] = [i];
            for (let j = 0; j <= a.length; j++) matrix[0][j] = j;

            for (let i = 1; i <= b.length; i++) {
                for (let j = 1; j <= a.length; j++) {
                    if (b.charAt(i - 1) === a.charAt(j - 1)) {
                        matrix[i][j] = matrix[i - 1][j - 1];
                    } else {
                        matrix[i][j] = Math.min(
                            matrix[i - 1][j - 1] + 1,
                            matrix[i - 1][j] + 1,
                            matrix[i][j - 1] + 1
                        );
                    }
                }
            }
            return matrix[b.length][a.length];
        }

        function findBestCorrection(word) {
            const cleanWord = word.toLowerCase();
            let bestMatch = '';
            let minDistance = Infinity;

            for (const validWord of VALID_DICTIONARY) {
                if (Math.abs(validWord.length - cleanWord.length) > 3) continue;
                
                const dist = levenshteinDistance(cleanWord, validWord);
                if (dist < minDistance) {
                    minDistance = dist;
                    bestMatch = validWord;
                }
            }

            if (minDistance <= 2 && bestMatch) {
                if (word.charAt(0) === word.charAt(0).toUpperCase() && word.charAt(0) !== word.charAt(0).toLowerCase()) {
                    return bestMatch.charAt(0).toUpperCase() + bestMatch.slice(1);
                }
                return bestMatch;
            }
            return null;
        }

