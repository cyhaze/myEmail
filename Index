<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cute Email Quest - English Practice Game</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Fredoka & Quicksand -->
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Quicksand:wght@500;600;700&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Canvas Confetti -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        kawaii: {
                            pink: '#ff85a1',
                            pinkLight: '#ffe5ec',
                            purple: '#a29bfe',
                            purpleDark: '#6c5ce7',
                            cyan: '#00cec9',
                            yellow: '#ffeaa7',
                            yellowDark: '#fdcb6e',
                            green: '#55efc4',
                            dark: '#2d3436'
                        }
                    },
                    fontFamily: {
                        heading: ['Fredoka', 'sans-serif'],
                        sans: ['Quicksand', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #f8f0fc;
            background-image: radial-gradient(#e0c3fc 1.5px, transparent 1.5px);
            background-size: 24px 24px;
        }

        .btn-3d {
            transition: all 0.1s ease;
            box-shadow: 0px 6px 0px #2d3436;
        }
        .btn-3d:active {
            transform: translateY(4px);
            box-shadow: 0px 2px 0px #2d3436;
        }

        .btn-3d-pink {
            background-color: #ff758f;
            border: 3px solid #2d3436;
        }
        .btn-3d-pink:hover {
            background-color: #ff4d6d;
        }

        .btn-3d-green {
            background-color: #00b894;
            border: 3px solid #2d3436;
        }
        .btn-3d-green:hover {
            background-color: #009677;
        }

        .btn-3d-purple {
            background-color: #a29bfe;
            border: 3px solid #2d3436;
        }

        .game-card {
            border: 4px solid #2d3436;
            box-shadow: 8px 8px 0px #2d3436;
        }

        .highlight-error {
            background-color: #ff758f;
            color: #ffffff;
            padding: 2px 6px;
            border-radius: 8px;
            font-weight: 700;
            border: 2px solid #2d3436;
            display: inline-block;
            margin: 1px 2px;
        }

        @keyframes float {
            0% { transform: translateY(0px) rotate(0deg); }
            50% { transform: translateY(-8px) rotate(2deg); }
            100% { transform: translateY(0px) rotate(0deg); }
        }
        .animate-float {
            animation: float 3s ease-in-out infinite;
        }
    </style>
</head>
<body class="text-slate-800 font-sans min-h-screen flex flex-col justify-between antialiased selection:bg-pink-300">

    <header class="bg-white border-b-4 border-slate-800 sticky top-0 z-50 py-3 px-4 shadow-sm">
        <div class="max-w-4xl mx-auto flex flex-wrap justify-between items-center gap-3">
            <div class="flex items-center space-x-3">
                <div class="w-12 h-12 bg-kawaii-pink rounded-2xl border-3 border-slate-800 flex items-center justify-center text-white text-2xl animate-float shadow-[3px_3px_0px_#2d3436]">
                    🎮
                </div>
                <div>
                    <h1 class="font-heading font-bold text-xl md:text-2xl text-slate-800 tracking-wide flex items-center gap-2">
                        EMAIL QUEST <span class="text-xs bg-kawaii-yellow px-2 py-0.5 rounded-full border-2 border-slate-800 font-bold">ENGLISH</span>
                    </h1>
                    <p class="text-xs font-bold text-indigo-600">Automated Grammar, Spelling & Punctuation Checker</p>
                </div>
            </div>

            <!-- Level Progress Badge -->
            <div id="levelBadge" class="bg-kawaii-yellow text-slate-900 border-3 border-slate-800 px-4 py-1.5 rounded-2xl font-heading font-bold text-xs shadow-[3px_3px_0px_#2d3436] flex items-center gap-2">
                <i class="fa-solid fa-gamepad text-pink-500"></i>
                <span id="levelText">LEVEL 1: PLAYER REGISTRATION</span>
            </div>
        </div>
    </header>

    <!-- Main Game Container -->
    <main class="max-w-4xl mx-auto px-4 py-6 w-full flex-grow">

        <section id="step1Card" class="game-card bg-white rounded-3xl p-6 md:p-8 max-w-lg mx-auto relative overflow-hidden">
            <div class="text-center mb-6">
                <div class="inline-block bg-pink-100 p-4 rounded-full border-3 border-slate-800 mb-3 animate-float">
                    <span class="text-5xl">🐱</span>
                </div>
                <h2 class="text-2xl font-heading font-bold text-slate-800">New Player Registration</h2>
                <p class="text-slate-600 text-xs font-semibold mt-1">Please enter your full name and class to begin your Email Quest challenge.</p>
            </div>

            <form id="studentForm" onsubmit="handleStartTask(event)" class="space-y-4">
                <div>
                    <label for="studentName" class="block text-xs font-heading font-bold uppercase tracking-wider text-slate-700 mb-1">
                        <i class="fa-solid fa-user-astronaut mr-1 text-pink-500"></i> Student Full Name
                    </label>
                    <input type="text" id="studentName" required placeholder="e.g. Amir bin Rosli" 
                        class="w-full px-4 py-3 border-3 border-slate-800 rounded-2xl outline-none focus:ring-4 focus:ring-pink-300 text-slate-800 font-bold">
                </div>

                <div>
                    <label for="studentClass" class="block text-xs font-heading font-bold uppercase tracking-wider text-slate-700 mb-1">
                        <i class="fa-solid fa-graduation-cap mr-1 text-indigo-500"></i> Class
                    </label>
                    <input type="text" id="studentClass" required placeholder="e.g. 2 Cemerlang" 
                        class="w-full px-4 py-3 border-3 border-slate-800 rounded-2xl outline-none focus:ring-4 focus:ring-pink-300 text-slate-800 font-bold">
                </div>

                <div class="pt-3">
                    <button type="submit" onclick="playClickSound()" class="btn-3d btn-3d-pink w-full text-white font-heading font-bold text-lg py-3.5 px-6 rounded-2xl flex items-center justify-center gap-2">
                        <span>START QUEST!</span>
                        <i class="fa-solid fa-play"></i>
                    </button>
                </div>
            </form>
        </section>

        <section id="step2Card" class="hidden space-y-6">
            
            <!-- Player Status HUD Bar -->
            <div class="game-card bg-white rounded-2xl p-4 flex flex-wrap items-center justify-between gap-3">
                <div class="flex items-center space-x-3">
                    <div class="w-12 h-12 rounded-2xl bg-kawaii-pink border-3 border-slate-800 text-white flex items-center justify-center font-heading font-bold text-xl shadow-[2px_2px_0px_#2d3436]">
                        <span id="badgeInitial">M</span>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <h3 class="font-heading font-bold text-slate-800 text-base md:text-lg" id="displayName">-</h3>
                            <span class="bg-indigo-100 text-indigo-800 text-[10px] font-bold px-2 py-0.5 rounded-full border border-indigo-300">PLAYER 1</span>
                        </div>
                        <p class="text-xs font-bold text-slate-500">Class: <span id="displayClass" class="text-pink-600">-</span></p>
                    </div>
                </div>

                <button onclick="resetToStep1(); playClickSound();" class="text-xs font-heading font-bold text-slate-600 hover:text-pink-600 underline flex items-center gap-1">
                    <i class="fa-solid fa-rotate-left"></i> Change Player
                </button>
            </div>

            <!-- Email Prompt Quest Box -->
            <div class="game-card bg-kawaii-yellow rounded-3xl p-5 md:p-6 relative">
                <div class="absolute -top-4 left-6 bg-slate-800 text-white px-3 py-1 rounded-xl text-xs font-heading font-bold tracking-wider flex items-center gap-1.5">
                    <span>📜 MISSION PROMPT</span>
                </div>

                <div class="bg-white p-4 md:p-5 rounded-2xl border-3 border-slate-800 mt-2 space-y-3 text-slate-800">
                    <div>
                        <p class="font-bold text-base md:text-lg text-slate-900 leading-snug">
                            Your school is organizing an International Food Fair next weekend. Write an email to your friend, Kevin, to invite him to go with you.
                        </p>
                    </div>
                    
                    <div class="bg-pink-50 p-3.5 rounded-xl border-2 border-pink-200 space-y-1.5">
                        <p class="font-heading font-bold text-xs uppercase text-pink-700">In your email, you MUST include:</p>
                        <ul class="list-disc pl-5 text-xs md:text-sm font-semibold text-slate-700 space-y-1">
                            <li><strong>Invite Kevin</strong> to the food fair</li>
                            <li><strong>State the day and time</strong> you want to meet</li>
                            <li><strong>Tell him ONE type of food</strong> you want to try there</li>
                        </ul>
                    </div>

                    <div class="flex items-center justify-between text-xs font-bold text-slate-600 pt-1">
                        <span><i class="fa-solid fa-bullseye text-pink-500 mr-1"></i> Target Length: 30 to 50 words</span>
                    </div>
                </div>
            </div>

            <div class="game-card bg-white rounded-3xl p-5 md:p-6 space-y-4">
                
                <!-- Mandatory Email Format Rules Warning Card -->
                <div class="bg-amber-100 border-3 border-slate-800 p-4 rounded-2xl flex items-start gap-3 text-xs text-amber-950 font-bold">
                    <span class="text-2xl">⚡</span>
                    <div class="space-y-1">
                        <p class="font-heading text-sm text-amber-900 uppercase">Mandatory Email Format Rules:</p>
                        <ul class="list-disc pl-4 space-y-0.5 font-semibold text-amber-900">
                            <li>Must start with a greeting: <code class="bg-white px-1.5 py-0.5 rounded border border-amber-300 font-bold">Hi Kevin,</code> / <code class="bg-white px-1.5 py-0.5 rounded border border-amber-300 font-bold">Hello Kevin,</code> / <code class="bg-white px-1.5 py-0.5 rounded border border-amber-300 font-bold">Dear Kevin,</code></li>
                            <li>Must end with a closing sender name at the bottom (e.g. <code class="bg-white px-1.5 py-0.5 rounded border border-amber-300 font-bold">From, Amir</code> or <code class="bg-white px-1.5 py-0.5 rounded border border-amber-300 font-bold">Your friend, Amir</code>)</li>
                        </ul>
                        <p class="text-[11px] text-rose-700 font-bold pt-0.5">⚠️ Submissions without a greeting or sender name will be blocked.</p>
                    </div>
                </div>

                <!-- Validation Error Blocking Alert Modal -->
                <div id="validationErrorBox" class="hidden bg-rose-50 border-3 border-rose-600 rounded-2xl p-4 text-xs font-bold text-rose-900 space-y-2">
                    <div class="flex items-center gap-2 text-rose-700 font-heading text-sm">
                        <i class="fa-solid fa-circle-exclamation text-lg text-rose-600"></i>
                        <span>CANNOT SUBMIT EMAIL RESPONSE</span>
                    </div>
                    <ul id="validationErrorList" class="list-disc pl-5 space-y-1 text-slate-800">
                        <!-- Dynamic blocking errors -->
                    </ul>
                </div>

                <!-- EXP / Word Count Progress Bar -->
                <div class="space-y-1.5">
                    <div class="flex justify-between items-center text-xs font-heading font-bold">
                        <span class="text-slate-700"><i class="fa-solid fa-bolt text-amber-400 mr-1"></i> WORD COUNT (EXP METER):</span>
                        <span id="wordCountBadge" class="bg-slate-100 px-3 py-1 rounded-full border-2 border-slate-800">0 / 30-50 words</span>
                    </div>
                    <div class="w-full bg-slate-100 rounded-full h-4 border-2 border-slate-800 overflow-hidden p-0.5">
                        <div id="expProgressBar" class="bg-kawaii-pink h-full rounded-full transition-all duration-300" style="width: 0%"></div>
                    </div>
                </div>

                <!-- Email Header Simulation -->
                <div class="bg-slate-50 p-3 rounded-2xl border-2 border-slate-200 text-xs font-bold space-y-1">
                    <div class="flex items-center gap-2">
                        <span class="text-slate-400 w-12">TO:</span>
                        <span class="bg-white border border-slate-300 px-2 py-0.5 rounded text-slate-700">kevin@school.com</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-slate-400 w-12">SUBJECT:</span>
                        <span class="text-slate-800">Invitation to International Food Fair</span>
                    </div>
                </div>

                <!-- Text Area Input -->
                <div>
                    <textarea id="emailInput" rows="8" oninput="updateWordCount()" 
                        placeholder="Hi Kevin,&#10;&#10;Our school is having an International Food Fair next weekend. Would you like to come with me? Let's meet this Saturday at 10:00 a.m. I really want to try Japanese sushi there!&#10;&#10;See you soon,&#10;Amir" 
                        class="w-full p-4 border-3 border-slate-800 rounded-2xl outline-none focus:ring-4 focus:ring-pink-300 font-sans text-base leading-relaxed text-slate-800"></textarea>
                </div>

                <!-- Mascot Writing Guide in English -->
                <div class="bg-purple-50 rounded-2xl p-3 border-2 border-purple-200">
                    <details class="group">
                        <summary class="cursor-pointer text-xs font-heading font-bold text-purple-800 flex items-center justify-between">
                            <span class="flex items-center gap-1.5">
                                <span class="text-base">🐱</span> Mascot Mimi's Writing Guide
                            </span>
                            <i class="fa-solid fa-chevron-down group-open:rotate-180 transition-transform"></i>
                        </summary>
                        <div class="mt-2 text-xs font-semibold text-slate-700 space-y-2 pt-2 border-t border-purple-200">
                            <div>
                                <p class="text-slate-900"><strong>1. Greeting & Sign-off:</strong> Begin with <em>Hi Kevin,</em> or <em>Dear Kevin,</em> and finish with your name at the bottom!</p>
                            </div>
                            <div>
                                <p class="text-slate-900"><strong>2. Punctuation:</strong> Put a comma `,` after <em>Hi Kevin,</em> and a period `.` at the end of every sentence.</p>
                            </div>
                            <div>
                                <p class="text-slate-900"><strong>3. Apostrophes:</strong> Write <em>don't</em>, <em>can't</em>, <em>let's</em>, <em>I'm</em> (instead of dont/cant/lets/im).</p>
                            </div>
                            <div>
                                <p class="text-slate-900"><strong>4. Prepositions:</strong> Use correct prepositions: <em>on Saturday</em>, <em>at 10:00 a.m.</em>, <em>invite you to</em>.</p>
                            </div>
                            <div>
                                <p class="text-slate-900"><strong>5. Spelling:</strong> Make sure words like <em>friend</em>, <em>tomorrow</em>, and <em>sushi</em> are spelled correctly.</p>
                            </div>
                        </div>
                    </details>
                </div>

                <!-- Action Buttons -->
                <div class="flex items-center justify-between pt-2">
                    <button type="button" onclick="clearText(); playClickSound();" class="text-xs font-heading font-bold text-slate-500 hover:text-slate-800">
                        <i class="fa-solid fa-trash mr-1"></i> Clear Text
                    </button>
                    <button type="button" onclick="analyzeEmail(); playClickSound();" class="btn-3d btn-3d-green text-white font-heading font-bold px-6 py-3 rounded-2xl flex items-center gap-2">
                        <span>CHECK SPELLING & GRAMMAR</span>
                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                    </button>
                </div>

            </div>

            <div id="feedbackSection" class="hidden space-y-6">
                
                <!-- Criteria Check Grid -->
                <div class="game-card bg-white rounded-3xl p-5 md:p-6 space-y-4">
                    <h3 class="font-heading font-bold text-slate-800 text-lg flex items-center gap-2">
                        <span>🎯</span> Mission Objectives Checklist <span class="text-xs font-bold text-slate-500">(Semakan Syarat Soalan)</span>
                    </h3>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                        <div id="reqInvite" class="p-3.5 rounded-2xl border-2 border-slate-300 bg-slate-50 flex items-start space-x-3">
                            <div id="reqInviteIcon" class="mt-0.5"><i class="fa-solid fa-circle-notch animate-spin text-slate-400"></i></div>
                            <div class="text-xs">
                                <p class="font-heading font-bold text-slate-800">1. Invite Kevin</p>
                                <p class="text-slate-500 font-semibold mt-0.5">(Jemputan ke Food Fair)</p>
                            </div>
                        </div>

                        <div id="reqDateTime" class="p-3.5 rounded-2xl border-2 border-slate-300 bg-slate-50 flex items-start space-x-3">
                            <div id="reqDateTimeIcon" class="mt-0.5"><i class="fa-solid fa-circle-notch animate-spin text-slate-400"></i></div>
                            <div class="text-xs">
                                <p class="font-heading font-bold text-slate-800">2. Day & Time</p>
                                <p class="text-slate-500 font-semibold mt-0.5">(Hari & Masa berjumpa)</p>
                            </div>
                        </div>

                        <div id="reqFood" class="p-3.5 rounded-2xl border-2 border-slate-300 bg-slate-50 flex items-start space-x-3">
                            <div id="reqFoodIcon" class="mt-0.5"><i class="fa-solid fa-circle-notch animate-spin text-slate-400"></i></div>
                            <div class="text-xs">
                                <p class="font-heading font-bold text-slate-800">3. Mention Food</p>
                                <p class="text-slate-500 font-semibold mt-0.5">(Jenis makanan nak cuba)</p>
                            </div>
                        </div>
                    </div>

                    <!-- Word Count Feedback Banner -->
                    <div id="wordCountBanner" class="p-3.5 rounded-2xl text-xs font-semibold flex items-center justify-between border-2">
                        <!-- Dynamic JS Content -->
                    </div>
                </div>

                <!-- Grammar & Spelling Analysis -->
                <div class="game-card bg-white rounded-3xl p-5 md:p-6 space-y-4">
                    <div class="flex items-center justify-between flex-wrap gap-2">
                        <h3 class="font-heading font-bold text-slate-800 text-lg flex items-center gap-2">
                            <span>🔍</span> Grammar, Spelling & Punctuation Review
                        </h3>
                        <span id="scoreBadge" class="text-xs font-heading font-bold px-3 py-1.5 rounded-xl border-2 border-slate-800 bg-purple-100 text-purple-900">
                            GRADE: -
                        </span>
                    </div>

                    <!-- Highlighted Text Display -->
                    <div>
                        <p class="text-xs font-heading font-bold text-slate-500 uppercase tracking-wider mb-1">Your Submitted Text (Errors Highlighted):</p>
                        <div id="highlightedOutput" class="p-4 bg-slate-50 rounded-2xl border-2 border-slate-300 text-slate-800 font-medium leading-relaxed text-base whitespace-pre-wrap">
                            <!-- Highlighted text output -->
                        </div>
                    </div>

                    <!-- Dynamic Suggestions List with BM Guidance -->
                    <div id="suggestionsContainer" class="space-y-3 pt-2">
                        <!-- Suggestions appended here -->
                    </div>

                    <!-- Proceed to Certificate -->
                    <div class="pt-4 border-t-2 border-slate-100 flex justify-end">
                        <button onclick="goToStep3(); playVictorySound();" class="btn-3d btn-3d-pink text-white font-heading font-bold px-6 py-3.5 rounded-2xl flex items-center gap-2">
                            <span>GENERATE CERTIFICATE & PROOF CARD</span>
                            <i class="fa-solid fa-trophy"></i>
                        </button>
                    </div>
                </div>

            </div>

        </section>

        <section id="step3Card" class="hidden max-w-xl mx-auto space-y-6">
            
            <div class="bg-pink-100 border-3 border-slate-800 rounded-2xl p-4 text-xs font-bold text-slate-800 flex items-center gap-3">
                <span class="text-3xl">📸</span>
                <div>
                    <p><strong>Proof Submission:</strong> Please take a <strong>screenshot</strong> of this card to submit to your teacher as proof of completion!</p>
                </div>
            </div>

            <!-- Printable Certificate Badge Card -->
            <div id="printableCard" class="game-card bg-white rounded-3xl p-6 md:p-8 relative overflow-hidden">
                <div class="absolute -right-6 -top-6 w-24 h-24 bg-kawaii-yellow rounded-full border-3 border-slate-800 flex items-end justify-start p-4 text-2xl">
                    ⭐
                </div>

                <div class="border-b-3 border-slate-800 pb-4 mb-5 flex items-center gap-3">
                    <div class="w-12 h-12 bg-kawaii-pink rounded-2xl border-3 border-slate-800 text-white flex items-center justify-center text-2xl font-heading">
                        🏆
                    </div>
                    <div>
                        <span class="text-[10px] font-heading font-bold uppercase tracking-widest text-pink-600">VICTORY LOOT CARD</span>
                        <h2 class="font-heading font-bold text-xl text-slate-800">ENGLISH EMAIL QUEST CERTIFICATE</h2>
                    </div>
                </div>

                <!-- Student Info Grid -->
                <div class="grid grid-cols-2 gap-3 bg-purple-50 p-4 rounded-2xl border-2 border-purple-200 mb-5 text-xs font-bold text-slate-800">
                    <div>
                        <span class="text-[10px] text-purple-600 uppercase block font-heading">Player Name:</span>
                        <span id="certName" class="text-sm font-bold text-slate-900">-</span>
                    </div>
                    <div>
                        <span class="text-[10px] text-purple-600 uppercase block font-heading">Class:</span>
                        <span id="certClass" class="text-sm font-bold text-slate-900">-</span>
                    </div>
                    <div>
                        <span class="text-[10px] text-purple-600 uppercase block font-heading">Word Count:</span>
                        <span id="certWordCount" class="text-pink-600">-</span>
                    </div>
                    <div>
                        <span class="text-[10px] text-purple-600 uppercase block font-heading">Mission Objectives:</span>
                        <span id="certScore" class="text-emerald-600">-</span>
                    </div>
                </div>

                <!-- Submitted Email Content -->
                <div class="space-y-1.5 mb-6">
                    <h4 class="text-[10px] font-heading font-bold text-slate-500 uppercase tracking-wider">Submitted Email Response:</h4>
                    <div class="bg-slate-50 border-2 border-slate-800 rounded-2xl p-4 text-slate-800 font-sans text-sm font-semibold leading-relaxed whitespace-pre-wrap" id="certEmailText">
                        <!-- Content -->
                    </div>
                </div>

                <!-- Stamp Verification -->
                <div class="pt-4 border-t-2 border-slate-100 flex items-center justify-between text-xs text-slate-500 font-bold">
                    <div>
                        <p class="text-slate-800 font-heading">Task: Email Invitation to Kevin</p>
                        <p class="text-[10px] text-slate-400" id="finalDate">Date: -</p>
                    </div>
                    <div class="bg-emerald-100 text-emerald-800 border-2 border-slate-800 px-3 py-1 rounded-xl text-[10px] font-heading font-bold">
                        <i class="fa-solid fa-shield-halved mr-1"></i> VERIFIED BY GAME SYSTEM
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center justify-between gap-3 pt-2">
                <button onclick="backToEdit(); playClickSound();" class="text-xs font-heading font-bold text-slate-600 hover:text-slate-900 flex items-center gap-1.5">
                    <i class="fa-solid fa-arrow-left"></i> Edit Response
                </button>

                <button onclick="window.print()" class="btn-3d btn-3d-purple text-slate-900 font-heading font-bold px-6 py-3 rounded-2xl text-xs flex items-center gap-2">
                    <i class="fa-solid fa-print"></i> Print / Save as PDF
                </button>
            </div>

        </section>

    </main>

    <footer class="py-4 text-center text-xs font-bold text-slate-500">
